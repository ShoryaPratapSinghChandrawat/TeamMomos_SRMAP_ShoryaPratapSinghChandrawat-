<script>
(function () {
  var slides = Array.prototype.slice.call(document.querySelectorAll(".slide"));
  var dots = document.getElementById("dots");
  var bar = document.getElementById("bar");
  var count = document.getElementById("count");
  var cur = 0, N = slides.length;

  slides.forEach(function (s, i) {
    var d = document.createElement("i");
    d.title = "Slide " + (i + 1);
    d.addEventListener("click", function () { go(i); });
    dots.appendChild(d);
  });
  var dotEls = Array.prototype.slice.call(dots.children);

  function go(n) {
    n = Math.max(0, Math.min(N - 1, n));
    if (n === cur && slides[cur].classList.contains("active")) return;
    slides.forEach(function (s, i) {
      s.classList.toggle("active", i === n);
      s.classList.toggle("prev", i < n);
    });
    // stagger the reveals inside the entering slide
    var rvs = slides[n].querySelectorAll(".rv");
    Array.prototype.forEach.call(rvs, function (el, i) {
      el.style.transitionDelay = (0.12 + i * 0.09).toFixed(2) + "s";
    });
    dotEls.forEach(function (d, i) { d.classList.toggle("on", i === n); });
    bar.style.transform = "scaleX(" + ((n + 1) / N) + ")";
    count.textContent = (n + 1) + " / " + N;
    cur = n;
    if (history.replaceState) history.replaceState(null, "", "#" + (n + 1));
  }

  document.addEventListener("keydown", function (e) {
    if (e.key === "ArrowRight" || e.key === " " || e.key === "PageDown") { e.preventDefault(); go(cur + 1); }
    else if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); go(cur - 1); }
    else if (e.key === "Home") go(0);
    else if (e.key === "End") go(N - 1);
    else if (e.key.toLowerCase() === "f") fs();
  });
  document.getElementById("zone-r").addEventListener("click", function () { go(cur + 1); });
  document.getElementById("zone-l").addEventListener("click", function () { go(cur - 1); });

  var fsBtn = document.getElementById("fs");
  function fs() {
    if (document.fullscreenElement) document.exitFullscreen();
    else if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen();
  }
  fsBtn.addEventListener("click", fs);

  // touch swipe
  var tx = null;
  document.addEventListener("touchstart", function (e) { tx = e.touches[0].clientX; }, { passive: true });
  document.addEventListener("touchend", function (e) {
    if (tx == null) return;
    var dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx) > 46) go(cur + (dx < 0 ? 1 : -1));
    tx = null;
  }, { passive: true });

  var start = parseInt((location.hash || "#1").slice(1), 10);
  go(isNaN(start) ? 0 : start - 1);
})();
</script>
